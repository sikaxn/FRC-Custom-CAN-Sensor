{
  "name": "imassistant",
  "version": "1.0.0b",
  "description": "IM assistant allow you to update firmware and config IM dev boards.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "esp-web-tools": "^10.1.1",
    "marked": "^15.0.0",
    "serialport": "^12.0.0",
    "smartcard": "^3.7.0"
  },
  "build": {
    "appId": "com.yourname.imassistant",
    "productName": "IMAssistant",
    "icon": "assets/team_logo_square.ico",
    "win": {
      "target": [
        "dir",
        "zip"
      ]
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{test,__tests__}/**"
    ],
    "artifactName": "IMAssistant-${version}.zip"
  }
}
